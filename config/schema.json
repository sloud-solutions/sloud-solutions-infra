{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Merged config (common + environment)",
  "type": "object",
  "required": ["project", "environment", "aws", "backend", "github", "website", "tags"],
  "additionalProperties": false,
  "properties": {
    "project": { "type": "string", "pattern": "^[a-z0-9-]{3,30}$" },
    "environment": { "type": "string", "pattern": "^[a-z0-9-]{2,12}$" },
    "aws": {
      "type": "object",
      "required": ["region"],
      "additionalProperties": false,
      "properties": { "region": { "type": "string", "const": "us-east-1" } }
    },
    "backend": {
      "type": "object",
      "required": ["bucket", "key", "region"],
      "additionalProperties": false,
      "properties": {
        "bucket": { "type": "string", "pattern": "^[a-z0-9.-]{3,63}$" },
        "key": { "type": "string", "minLength": 1 },
        "region": { "type": "string" },
        "encrypt": { "type": "boolean" },
        "use_lockfile": { "type": "boolean" }
      }
    },
    "github": {
      "type": "object",
      "required": ["org", "infra_repo", "site_repo", "deploy_branch", "apply_environments"],
      "additionalProperties": false,
      "properties": {
        "org": { "type": "string" },
        "infra_repo": { "type": "string" },
        "site_repo": { "type": "string" },
        "deploy_branch": { "type": "string" },
        "apply_environments": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "website": {
      "type": "object",
      "required": ["domain_name", "include_www", "price_class", "default_root_object"],
      "additionalProperties": false,
      "properties": {
        "domain_name": {
          "type": ["string", "null"],
          "pattern": "^([a-z0-9-]+\\.)+[a-z]{2,}$"
        },
        "include_www": { "type": "boolean" },
        "price_class": { "enum": ["PriceClass_100", "PriceClass_200", "PriceClass_All"] },
        "default_root_object": { "type": "string" }
      }
    },
    "tags": { "type": "object", "additionalProperties": { "type": "string" } }
  }
}
